import {pool} from "../database/database"; 
import { ResultSetHeader, RowDataPacket } from "mysql2";
import { QuartosReserva,Quartos } from "../models/quarto";

async function fazerPedido(data:any){
   const sql = 'INSERT INTO pedidos (cliente_id, pagamento) VALUES (?,?)';
    
   try {
    const [result] = await pool.query<ResultSetHeader>(sql,[
        data.cliente_id,
        data.pagamento
    ]);
        return result.insertId;
   }catch(err){
    console.error('erro',err);
    return null;
   }
}

async function fazerReserva(idPedido:number, quarto:object) {
    const sql = 'INSERT INTO reservas (pedido_id,quarto_id, data_inicio, data_fim)VALUES (?,?,?,?)'

     try {
    const [result] = await pool.query<ResultSetHeader>(sql,[
        idPedido,
        quarto.id,
        quarto.dataInicio,
        quarto.dataFim,
    ]);
    return result.insertId;
   }catch(err){
    console.error('erro',err);
    return null;
   }
}


export default{
    fazerPedido,fazerReserva
}